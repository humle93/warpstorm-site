{"content": "<style>\n/* ============================================================\n   GRIMDARK CSS v1 (Warhammer-track) — WORKSHOP SKIN (additive, safe)\n   LEARN → BUILD → SHOP → COMPLETE THE LOOK\n   Tokens: black #0A0A0C · dark red #8C1D2C · gold #B8963E\n   bone #E8E0D0 · grey #9A9A9A · base bg #0A0A0C\n   ============================================================ */\n\n/* --- 3. Forsiden som værksted: 4 stationer --- */\n.sg-stations{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin:32px 0}\n.sg-station{position:relative;background:linear-gradient(160deg,rgba(184,150,62,.14),rgba(23,23,23,.55));border:1px solid rgba(184,150,62,.35);border-radius:10px;padding:26px 20px;text-align:center;text-decoration:none;color:#F3E8D0;overflow:hidden}\n.sg-station:hover{border-color:#B8963E;transform:translateY(-3px);transition:all .2s ease}\n.sg-station::before{content:\"\";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#8C1D2C,#B8963E,#8C1D2C)}\n.sg-station-no{display:inline-block;font-size:11px;letter-spacing:.25em;color:#B8963E;border:1px solid rgba(184,150,62,.5);border-radius:999px;padding:3px 12px;margin-bottom:12px}\n.sg-station h3{font-size:1.05rem;letter-spacing:.12em;text-transform:uppercase;margin:0 0 8px;color:#F3E8D0}\n.sg-station p{font-size:.92rem;color:#9A9A9A;margin:0;line-height:1.5}\n@media(max-width:900px){.sg-stations{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:520px){.sg-stations{grid-template-columns:1fr}}\n\n/* --- 5. Projektkort (BUILD/DIY format) --- */\n.sg-project-card{background:rgba(23,23,23,.72);border:1px solid rgba(184,150,62,.3);border-radius:10px;padding:24px;margin:28px 0}\n.sg-project-card .sg-pc-head{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}\n.sg-pc-badge{display:inline-block;font-size:12px;letter-spacing:.06em;color:#F3E8D0;background:rgba(184,150,62,.25);border:1px solid rgba(184,150,62,.45);border-radius:6px;padding:4px 10px}\n.sg-pc-badge b{color:#B8963E;font-weight:600}\n.sg-pc-difficulty b{color:#8C1D2C}\n.sg-project-card h2{margin-top:0}\n\n/* --- 4. Shop som værkstedsbutik: portal --- */\n.sg-shop-portal{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:28px 0}\n.sg-portal-choice{display:flex;flex-direction:column;justify-content:center;gap:6px;background:rgba(23,23,23,.72);border:1px solid rgba(184,150,62,.3);border-radius:10px;padding:22px 18px;color:#F3E8D0;text-decoration:none;text-align:center;min-height:120px}\n.sg-portal-choice:hover{border-color:#B8963E}\n.sg-portal-choice span{font-size:12px;letter-spacing:.2em;color:#B8963E;text-transform:uppercase}\n.sg-portal-choice strong{font-size:1rem;font-weight:600}\n@media(max-width:900px){.sg-shop-portal{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:520px){.sg-shop-portal{grid-template-columns:1fr}}\n\n/* --- 4b. Complete Looks kollektionsbadges --- */\n.sg-look-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin:28px 0}\n.sg-look{position:relative;border:1px solid rgba(184,150,62,.35);border-radius:10px;padding:20px 14px;text-align:center;color:#F3E8D0;text-decoration:none;background:linear-gradient(180deg,rgba(184,150,62,.12),rgba(11,6,32,.6))}\n.sg-look:hover{border-color:#B8963E}\n.sg-look strong{display:block;font-size:.98rem;margin-bottom:4px}\n.sg-look em{font-style:normal;font-size:.8rem;color:#9A9A9A}\n@media(max-width:900px){.sg-look-grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:480px){.sg-look-grid{grid-template-columns:1fr}}\n\n/* --- Guides → shop krydssalg --- */\n.sg-ctb{background:rgba(184,150,62,.12);border:1px solid rgba(184,150,62,.4);border-radius:10px;padding:18px 20px;margin:26px 0}\n.sg-ctb p{margin:0 0 10px;color:#F3E8D0}\n\n/* ============ v1.1 tilfoejelser: base + grim-komponenter ============ */\n:root{--grim-bg:#0A0A0C;--grim-red:#8C1D2C;--grim-gold:#B8963E;--grim-bone:#E8E0D0;--grim-grey:#9A9A9A;--grim-panel:rgba(23,23,23,.72)}\nbody{background:var(--grim-bg);color:var(--grim-bone)}\nh1,h2,h3,h4{color:#F3E8D0}\na{color:var(--grim-gold)}a:hover{color:#E0C084}\n.grim-hero{background:linear-gradient(180deg,rgba(140,29,44,.25),rgba(10,10,12,.92));border:1px solid rgba(184,150,62,.4);border-radius:12px;padding:48px 24px;text-align:center;margin:24px 0}\n.grim-hero h1{color:#F3E8D0;letter-spacing:.06em;margin:10px 0 14px}\n.grim-kicker{color:#B8963E;letter-spacing:.3em;text-transform:uppercase;font-size:12px}\n.grim-quote{border-left:3px solid #8C1D2C;background:rgba(140,29,44,.08);padding:14px 18px;border-radius:0 8px 8px 0;margin:24px 0}\n.grim-quote p{color:#E8E0D0;margin:0}\n.grim-table-wrap{overflow-x:auto;margin:24px 0}\n.grim-table{width:100%;border-collapse:collapse;background:var(--grim-panel);font-size:.95rem}\n.grim-table th{background:rgba(184,150,62,.2);color:#F3E8D0;letter-spacing:.06em;text-transform:uppercase;font-size:.8rem;padding:10px 12px;border:1px solid rgba(184,150,62,.35);text-align:left}\n.grim-table td{padding:10px 12px;border:1px solid rgba(184,150,62,.2);color:#E8E0D0}\n.grim-list{margin:16px 0;padding-left:22px}\n.grim-list li{margin:8px 0;color:#E8E0D0;line-height:1.6}\n.wp-block-image img{border:1px solid rgba(184,150,62,.35);border-radius:8px}\n.grim-btn{display:inline-block;background:linear-gradient(90deg,#8C1D2C,#B8963E);color:#0A0A0C;font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:.85rem;padding:12px 26px;border-radius:8px;text-decoration:none}\n.grim-btn:hover{filter:brightness(1.15);color:#0A0A0C}\n</style>\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002dheader-1\",\"style\":{\"spacing\":{\"padding\":{\"bottom\":\"var:preset|spacing|30\",\"top\":\"var:preset|spacing|30\"}}},\"layout\":{\"inherit\":true,\"type\":\"constrained\"}} -->\n<div\n\tclass=\"wp-block-group alignfull is-style-ext-preset--group--natural-1--header-1\"\n\tstyle=\"\n\t\tpadding-top: var(--wp--preset--spacing--30);\n\t\tpadding-bottom: var(--wp--preset--spacing--30);\n\t\"\n>\n\t<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"space-between\"}} -->\n\t<div class=\"wp-block-group alignwide\">\n\t\t<!-- wp:group {\"className\":\"ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n\t\t<div class=\"wp-block-group ext-animate--on\">\n\t\t\t<!-- wp:site-logo {\"shouldSyncIcon\":true} /-->\n\t\t\t<!-- wp:group -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t\t<!-- wp:site-title {\"level\":0,\"style\":{\"typography\":{\"textTransform\":\"uppercase\"}},\"fontSize\":\"medium\"} /-->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:group -->\n\t\t<!-- wp:group {\"className\":\"ext-animate\\u002d\\u002don\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n\t\t<div class=\"wp-block-group ext-animate--on\">\n\t\t\t<!-- wp:navigation {\"icon\":\"menu\",\"overlayBackgroundColor\":\"background\",\"overlayTextColor\":\"foreground\",\"layout\":{\"type\":\"flex\",\"setCascadingProperties\":true,\"justifyContent\":\"right\"}} -->\n\t\t\t<!-- wp:page-list {\"isNavigationChild\":true,\"showSubmenuIcon\":true,\"openSubmenusOnClick\":false} /-->\n\t\t\t<!-- /wp:navigation -->\n\t\t</div>\n\t\t<!-- /wp:group -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n\n"}